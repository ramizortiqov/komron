# Database
DATABASE_URL="postgresql://tm_limited:secure_password@localhost:5432/tm_limited?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# YooKassa (Payment)
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/success
YOOKASSA_WEBHOOK_URL=http://localhost:4000/api/payments/webhook

# CDEK (Delivery)
CDEK_CLIENT_ID=your_client_id
CDEK_CLIENT_SECRET=your_client_secret
CDEK_TEST_MODE=true
CDEK_API_URL=https://api.cdek.ru/v2

# Russian Post (Delivery)
RUSSIAN_POST_TOKEN=your_token
RUSSIAN_POST_KEY=your_key
RUSSIAN_POST_TEST_MODE=true
RUSSIAN_POST_API_URL=https://otpravka-api.pochta.ru

# Email/SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_NAME="TM LIMITED"
SMTP_FROM_EMAIL=noreply@tm-limited.ru

# File Upload
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_FORMATS=jpg,jpeg,png,webp,avif
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Session
SESSION_SECRET=your-session-secret-change-me

# Logging
LOG_LEVEL=debug
