# ==============================================
# TM LIMITED - Environment Variables Template
# ==============================================

# ==============================================
# DATABASE
# ==============================================
POSTGRES_USER=tm_limited
POSTGRES_PASSWORD=secure_password_change_me
POSTGRES_DB=tm_limited
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# ==============================================
# REDIS
# ==============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==============================================
# BACKEND API
# ==============================================
BACKEND_PORT=4000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:3000

# ==============================================
# FRONTEND
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="TM LIMITED"

# ==============================================
# PAYMENTS - YOOKASSA (ЮКАССА)
# ==============================================
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=http://localhost:3000/checkout/success
YOOKASSA_WEBHOOK_URL=http://localhost:4000/api/payments/webhook

# ==============================================
# DELIVERY - CDEK (СДЭК)
# ==============================================
CDEK_CLIENT_ID=your_client_id
CDEK_CLIENT_SECRET=your_client_secret
CDEK_TEST_MODE=true
CDEK_API_URL=https://api.cdek.ru/v2

# ==============================================
# DELIVERY - RUSSIAN POST (ПОЧТА РФ)
# ==============================================
RUSSIAN_POST_TOKEN=your_token
RUSSIAN_POST_KEY=your_key
RUSSIAN_POST_TEST_MODE=true
RUSSIAN_POST_API_URL=https://otpravka-api.pochta.ru

# ==============================================
# EMAIL / SMTP
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_NAME="TM LIMITED"
SMTP_FROM_EMAIL=noreply@tm-limited.ru

# ==============================================
# ANALYTICS
# ==============================================
NEXT_PUBLIC_YANDEX_METRIKA_ID=your_metrika_id
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# ==============================================
# FILE UPLOAD / STORAGE
# ==============================================
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_FORMATS=jpg,jpeg,png,webp,avif
UPLOAD_DIR=./uploads

# Optional: AWS S3 / Yandex Object Storage
S3_ENABLED=false
S3_BUCKET=tm-limited
S3_REGION=ru-central1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_ENDPOINT=https://storage.yandexcloud.net

# ==============================================
# SECURITY
# ==============================================
# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Session
SESSION_SECRET=your-session-secret-change-me

# ==============================================
# LOGGING
# ==============================================
LOG_LEVEL=debug

# ==============================================
# FEATURES FLAGS
# ==============================================
FEATURE_ADMIN_2FA=false
FEATURE_LOYALTY_PROGRAM=false
FEATURE_GIFT_CARDS=false
